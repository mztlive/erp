digraph resourceAuthorization {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.35", nodesep="0.30", ranksep="0.60", fontname="PingFang SC", fontsize=22, label="ERP 统一资源授权架构", labelloc=t, splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#f7f9fc", color="#c9d3e0", fontname="PingFang SC", fontsize=14, margin="0.18,0.12", penwidth=1.3];
  edge [fontname="PingFang SC", fontsize=11, color="#67788d", arrowsize=0.75];

  subgraph clusterSources {
    label="一、授权来源：产生授权，不直接放行";
    fontsize=16; fontcolor="#355984"; color="#c9dbef"; style="rounded";
    scope [label="组织与岗位政策\n公司 / 部门 / 本人负责"];
    business [label="业务事件\n创建 / 交接 / 分配 / 关闭"];
    bpm [label="BPM 与工作流\n有效节点 / 实际分配 / 执行代次"];
    sharing [label="受控共享与会话\n人工共享 / 外部访问 / 服务作业"];
    {rank=same; scope; business; bpm; sharing;}
  }
  policy [label="自动授权策略\n接收人资格 + 明确资源清单 + 动作 + 期限 + 撤销规则", fillcolor="#edf4ff", color="#6e9bd2"];
  scope -> policy; business -> policy; bpm -> policy; sharing -> policy;
  grants [label="有效数据授权\n部门 / 公司 / 指定资源选择器\n按同一资源和动作求并集；来源独立撤销", fillcolor="#eaf6f1", color="#60a58a"];
  policy -> grants [label="业务、任务、授权与审计同事务"];

  subgraph clusterAccess {
    label="二、统一判定：全部访问入口共用";
    fontsize=16; fontcolor="#355984"; color="#c9dbef"; style="rounded";
    request [label="管理列表 / 工作台 / 详情\nAPI / 文件 / 导出 / 后台命令"];
    identity [label="身份与强制边界\n账号有效 / 租户公司准入"];
    capability [label="功能权限\n是否具备此项操作能力"];
    dataCheck [label="资源动作授权\n是否能对这个资源做这个动作"];
    decision [label="统一授权结果\n身份边界 AND 功能权限 AND 数据授权", fillcolor="#e9f2ff", color="#557fb1", penwidth=2];
    {rank=same; identity; capability; dataCheck;}
    request -> identity; request -> capability; request -> dataCheck;
    identity -> decision; capability -> decision; dataCheck -> decision;
  }
  grants -> dataCheck [label="有效授权与授权版本"];
  grants -> request [style=invis];

  subgraph clusterUse {
    label="三、使用授权结果：业务规则继续生效";
    fontsize=16; fontcolor="#355984"; color="#c9dbef"; style="rounded";
    query [label="查询\n授权约束 + 用户筛选 → 分页 / 汇总\n待办的分配与状态仅作业务筛选"];
    command [label="执行\n业务状态 / 金额 / 版本 / 职责分离\n审批额外校验流程迁移"];
    material [label="输出\n完整对象或登记材料视图\n附件预览 / 下载分别授权"];
    {rank=same; query; command; material;}
  }
  decision -> query; decision -> command; decision -> material;
  audit [label="全程可解释、可撤销、可审计\n谁因哪个来源，在何版本对哪个资源具有何种动作", fillcolor="#fff8e9", color="#c8aa68"];
  query -> audit; command -> audit; material -> audit;
}
