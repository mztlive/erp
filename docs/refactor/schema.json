{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "crate重构清单",
  "type": "object",
  "required": ["crate", "generated_at", "source", "stats", "top3", "items"],
  "properties": {
    "crate": {"type": "string"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source": {"type": "string"},
    "stats": {
      "type": "object",
      "required": ["file_count", "approx_loc"],
      "properties": {
        "file_count": {"type": "integer", "minimum": 1},
        "approx_loc": {"type": "integer", "minimum": 1},
        "largest_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "top3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string"}
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "lines", "category", "severity", "title", "current", "proposal", "status", "updated_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-[0-9]{3}$"},
          "file": {"type": "string"},
          "lines": {"type": "string"},
          "category": {"enum": ["重复", "复杂度", "可读性", "错误处理", "类型建模", "性能隐患", "边界分层", "测试性"]},
          "severity": {"enum": ["高", "中", "低"]},
          "title": {"type": "string"},
          "current": {"type": "string"},
          "proposal": {"type": "string"},
          "status": {"enum": ["pending", "in_progress", "done", "wont_fix"]},
          "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
