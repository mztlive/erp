  "batches": {
    "G1": { "title": "平台与单据基础设施", "slug": "platform", "domains": ["D01", "D02", "D03", "D04", "D05", "D06"] },
    "G2": { "title": "业务伙伴", "slug": "party", "domains": ["D07", "D08", "D09"] },
    "G3": { "title": "商品与仓库", "slug": "catalog", "domains": ["D10", "D11"] },
    "G4": { "title": "合同与销售", "slug": "sales", "domains": ["D12", "D13", "D14"] },
    "G5": { "title": "采购与供应商商品库", "slug": "procurement", "domains": ["D15", "D24"] },
    "G6": { "title": "履约与库存", "slug": "fulfillment", "domains": ["D16", "D17"] },
    "G7": { "title": "财务往来与成本", "slug": "finance", "domains": ["D18", "D19", "D20", "D21"] },
    "G8": { "title": "一期导入与商城同步", "slug": "mall-sync", "domains": ["D22", "D23"] },
    "G9": { "title": "二期供给、发布与投影", "slug": "publication", "domains": ["D25", "D26", "D27"] },
    "G10": { "title": "二期商城消费与售后", "slug": "mall", "domains": ["D28", "D29", "D30", "D31"] },
    "G11": { "title": "二期供应商执行与结算", "slug": "supplier-exec", "domains": ["D32", "D33"] },
    "G12": { "title": "集成治理", "slug": "integration-ops", "domains": ["D34"] }
  },
  "layers": {
    "P0": {
      "title": "地基、防冲突改造与垂直样板",
      "doc": "P0-foundation.md",
      "parallel": 1,
      "must_compile": true
    },
    "P1": {
      "title": "领域模型",
      "doc": "P1-entities.md",
      "letter": "A",
      "parallel": 12,
      "must_compile": true,
      "owns_pattern": ["backend/entities/src/{module}/**"],
      "cross_batch_deps": false,
      "acceptance": ["gates.backend", "cargo test -p entities"]
    },
    "P2": {
      "title": "仓储",
      "doc": "P2-repository.md",
      "letter": "B",
      "parallel": 12,
      "must_compile": true,
      "owns_pattern": [
        "backend/database/src/repository/{module}.rs",
        "backend/database/src/repository/extensions/{module}.rs",
        "backend/database/src/indexes/{module}.rs"
      ],
      "cross_batch_deps": false,
      "acceptance": ["gates.backend"]
    },
    "P3": {
      "title": "服务与接口",
      "doc": "P3-service-api.md",
      "letter": "C",
      "parallel": 12,
      "must_compile": true,
      "owns_pattern": [
        "backend/services/src/{module}/**",
        "backend/apps/web-api/src/core/handler/{module}/**",
        "backend/apps/web-api/src/core/routes/{module}.rs"
      ],
      "cross_batch_deps": "repository_only",
      "acceptance": ["gates.backend", "permissions_no_drift"]
    },
    "P4": {
      "title": "前端集成",
      "doc": "P4-frontend.md",
      "letter": "F",
      "parallel": 10,
      "acceptance": ["gates.frontend", "mock_references_zero"]
    },
    "P5": {
      "title": "跨域加固（投影与治理）",
      "doc": "P5-hardening.md",
      "letter": "E",
      "parallel": 2,
      "must_compile": true,
      "acceptance": ["gates.backend"]
    },
    "P6": {
      "title": "后端集成测试收口",
      "doc": "P6-integration-tests.md",
      "letter": "I",
      "parallel": 12,
      "must_compile": true,
      "owns_pattern": [
        "backend/database/tests/{module}_repository.rs",
        "backend/apps/web-api/tests/{module}_api.rs"
      ],
      "acceptance": ["gates.backend", "gates.backend_integration"],
      "$comment_acceptance": "I-X1/X2/X3 额外 owns 为 tests/invariants|concurrency 等，见 P6 文档"
    }
  },
