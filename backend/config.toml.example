[app]
port = 10001
# 安全占位值会被启动校验拒绝；请替换为至少 32 个随机字节。
secret = "replace-with-at-least-32-random-bytes"

[database]
# 请修改为你的 MongoDB 连接字符串
uri = "mongodb://username:password@host:port/database"
db_name = "rs_project_template"

# 上传强制使用 S3 或 S3-compatible 对象存储；启动前必须替换凭证与 URL。
[s3]
bucket = "erp-assets"
region = "cn-south-1"
# AWS S3 可省略 endpoint；MinIO/云厂商兼容服务必须填写完整 URL。
endpoint = "https://s3.example.com"
access_key_id = "replace-with-access-key-id"
secret_access_key = "replace-with-secret-access-key"
# 仅临时凭证需要 session_token。
# session_token = "replace-with-session-token"
key_prefix = "erp/uploads"
# CDN 或 bucket 公开访问基础 URL；上传响应使用该值生成文件 URL。
public_base_url = "https://cdn.example.com"
# MinIO 等需要 path-style URL 的服务设为 true。
force_path_style = false

# 可选。仅当数据库里还没有账号 admin 时，进程启动会用这个密码创建超级管理员并绑定 role-root。
# 账号已存在时忽略，不会修改密码、状态或角色。首次登录成功后应删除本段并重启。
# 密码为 6 到 32 个字符，不能使用示例占位值。
# [bootstrap]
# initial_admin_password = "replace-with-6-to-32-characters"

# 可选。打开后，超级管理员可在「系统管理 / 演示主数据」生成或删除一批主数据。
# 关闭时按钮仍可见，但接口拒绝写入。不要在生产环境打开。
# [demo]
# master_data = false

# 可选：阿里云文档结构化 OCR。启用前开通 RecognizeDocumentStructure 并配置 RAM 权限。
# 使用杭州端点；本机须安装 Poppler（运行镜像已安装）。AI 提取须配置下方 contract_ai。
# [aliyun_ocr]
# pdftoppm_path = "pdftoppm"
# [aliyun_ocr.credentials]
# access_key_id = "<RAM AccessKey ID>"
# access_key_secret = "<RAM AccessKey Secret>"
# security_token = "<STS SecurityToken>" # 使用临时凭据时填写；长期 AK/SK 删除此项

# 可选合同 AI 提取。使用 rig-core 的 OpenAI Responses API 协议。
# base_url 填 API 前缀，不包含 /responses 或 /chat/completions；模型必须支持 text.format 的严格 JSON Schema 输出。
# DeepSeek 的 base_url 为 https://api.deepseek.com，model 可填 deepseek-flash。
# 远程地址必须为 HTTPS；本地 loopback 服务允许 HTTP。配置只从本文件或 Nacos 读取。
# [contract_ai]
# provider_id = "contract-ai-primary" # 必填非敏感连接标识；更换供应商/网关时使用新标识
# base_url = "https://your-provider.example/v1"
# api_key = "<API key>"
# model = "<provider model ID>"
# timeout_seconds = 90 # 1..120；OCR 与 AI 仍共用 180 秒总预算
# max_output_tokens = 8192 # 256..32768；超限截断导致任务失败，不截断后归档

# 蛋糕叔叔：默认关闭。真实凭据只写入已忽略的 config.toml 或受控 Nacos。
# 启用、绑定与回滚要求见 docs/dangaoshushu-connector-contract.md；修改后重启 Web API。
[dangaoshushu]
enabled = false # 登记技术配置；供应商、连接、环境及业务启停在后台管理
base_url = "https://dev.dangaoss.cn" # 仅 HTTPS origin，不含接口路径、查询参数或凭据
channel_no = ""
private_key = ""
user_id = "" # 供应商地址及订单使用的固定用户标识；准备地址前必须填写
timestamp_unit = "milliseconds" # seconds / milliseconds
timeout_seconds = 15 # 1..30；连接超时取此值与 5 秒中的较小值
callback_max_skew_seconds = 300 # 1..900；按推送接收时间核验
requests_per_second = 5 # 1..100；当前进程限额，等待配额最多 timeout_seconds，不重试请求
clearing_price_is_tax_inclusive_cny = false # 核实结算价为人民币含税供货价后才可开启

[dangaoshushu.spec_units]
# 供应商 spec_id -> 与公司 SKU 一致的计量单位；缺失时不生成报价。
# "<supplier-spec-id>" = "个"

[dangaoshushu.city_regions]
# 供应商 city_id -> 公司标准地区编码；值必须唯一，不直接混用两套地区 ID。
# "<supplier-city-id>" = "<company-region-code>"
